{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repositories",
    "targets",
    "tools",
    "manifests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "references",
          "development",
          "release"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
            }
          },
          "development": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "fixed"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "semver"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "date"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_id",
          "path",
          "manifests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
          },
          "repository_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "manifests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "e2e",
                "design"
              ]
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktrunk",
        "graphify"
      ],
      "properties": {
        "worktrunk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "required_for_tasks",
            "config"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required_for_tasks": {
              "type": "boolean"
            },
            "config": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "graphify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "procedure"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "procedure": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "revision"
        ],
        "properties": {
          "id": {
            "enum": [
              "e2e",
              "design"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  }
}
